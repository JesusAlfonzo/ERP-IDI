generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS
// ==========================================

enum LocationType {
  ALMACEN_GENERAL
  LABORATORIO
  OFICINA
  DEPOSITO
}

enum FridgeStatus {
  OPERATIVO
  MANTENIMIENTO
  DEFECTUOSO
  FUERA_DE_SERVICIO
}

enum OrderStatus {
  BORRADOR
  ENVIADA
  PARCIAL
  COMPLETADA
  CANCELADA
}

enum PurchaseRequisitionStatus {
  BORRADOR
  EN_COTIZACION
  ADJUDICADA
  CANCELADA
}

enum PaymentStatus {
  PENDIENTE
  PAGADO_PARCIAL
  PAGADO
  EXONERADO
}

enum ReceptionStatus {
  PENDIENTE
  PARCIAL
  COMPLETO
}

enum PaymentMethod {
  TRANSFERENCIA_USD
  TRANSFERENCIA_BS
  TRANSFERENCIA_NACIONAL
  PAGO_MOVIL
  TRANSFERENCIA_INTERNACIONAL
  EFECTIVO_USD
  EFECTIVO_BS
}

enum BatchStatus {
  DISPONIBLE
  EN_CUARENTENA
  DEFECTUOSO
  VENCIDO
  AGOTADO
}

enum StockMovementType {
  ENTRADA_COMPRA
  TRASLADO_A_LABORATORIO
  DESPACHO_SOLICITUD
  AJUSTE_INVENTARIO
  DESCARTE_MERMA
  PAGO_ORDEN
  EGRESO_DIRECTO
}

enum LabUnitStatus {
  IN_TRANSIT_TO_LAB
  SELLADO
  EN_USO
  INTERNAL_QUARANTINE
  AGOTADO
  DISCARDED
  DESCARTADO
}

enum LabItemType {
  REAGENT_KIT
  STANDALONE_CALIBRATOR
  CONTROL
  CONSUMABLE
}

enum StockOwnership {
  CLINICAL_ROUTINE
  RESEARCH_PROJECT
}

enum QuarantineInstanceType {
  RECEPTION_PURCHASING
  INTERNAL_LAB
}

enum QuarantineReason {
  COLD_CHAIN_BREAK
  CALIBRATION_FAILURE
  CONTAMINATION
  DAMAGED_PACKAGING
  EXPIRED
  OTHER
}

enum QuarantineResolutionStatus {
  PENDING
  RETURNED_TO_SUPPLIER
  REINTEGRATED_TO_STOCK
  WRITTEN_OFF_AS_LOSS
}

enum LabInternalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}

enum LabWeeklyRunStatus {
  OPEN_ACCUMULATING
  CLOSED_RECONCILED
  CANCELLED
}

enum RepeatReason {
  CALIBRATION_FAILURE
  CRITICAL_VALUE_CONFIRMATION
  COMPLEX_SAMPLE
  OPERATOR_ERROR
  OTHER
}

enum ConsumptionConcept {
  PATIENT
  REPEAT
  CALIBRATION
  CONTROL
  WASTE
  YIELD_SURPLUS
  YIELD_DEFICIT
  QUARANTINE_LOCK
  PHYSICAL_AUDIT_ADJUSTMENT
}

enum FridgeAuditAdjustmentStatus {
  PENDING_ADJUSTMENT
  ADJUSTED_AND_RECONCILED
  FLAGGED_DISCREPANCY
}

enum LabMovementType {
  CONSUMO_PRUEBAS
  TRASLADO_NEVERA
  DESCARTE
}

enum RequestStatus {
  PENDIENTE
  APROBADA
  DESPACHADA_PARCIAL
  COMPLETADA
  RECHAZADA
}

enum RequestPriority {
  BAJA
  RUTINA
  URGENTE
}

enum IncidentType {
  FALLA_CONTROL_CALIDAD
  CADENA_FRIO_ROTA
  DANO_FISICO
  CONTAMINACION_PRECIPITADO
  VENCIMIENTO_PREMATURO
  OTRO
}

enum IncidentStatus {
  ABIERTA
  CONFIRMADA
  DESCARTADA
}

enum ResearchProjectType {
  TEACHING
  THESIS
  INSTITUTIONAL
  EXTERNAL_COLLABORATION
}

enum ResearchProjectStatus {
  FORMULATION
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ResearchMemberRole {
  PRINCIPAL_INVESTIGATOR
  CO_INVESTIGATOR
  PROFESSOR
  THESIS_STUDENT
  LAB_ASSISTANT
}

enum ResearchInvestorType {
  PUBLIC_GRANT
  UNIVERSITY_FUND
  PRIVATE_COMPANY
  NGO_INTERNATIONAL
  INDIVIDUAL
}

enum ResearchTransferDirection {
  CLINICAL_TO_RESEARCH
  RESEARCH_TO_CLINICAL
}

enum ResearchTrialStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ResearchFindingType {
  EXPERIMENTAL_RESULT
  MILESTONE
  THESIS_CHAPTER
  PUBLICATION
  ACADEMIC_MATERIAL
}

// ==========================================
// 2. SEGURIDAD Y ACCESO (RBAC + AUTH)
// ==========================================

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  department   String   @map("department")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userRoles               UserRole[]
  refreshTokens           RefreshToken[]
  createdExchanges        CurrencyExchange[]
  createdOrders           Order[]
  createdStockMovements   StockMovement[]
  openedLabUnits          LabReagentUnit[]   @relation("LabUnitOpenedBy")
  executedLabMovements    LabStockMovement[]
  requests                Request[]          @relation("UserRequests")
  approvedRequests        Request[]          @relation("UserApprovedRequests")
  registeredPayments      OrderPayment[]
  reportedIncidents       BatchIncident[]    @relation("ReportedIncidents")
  resolvedIncidents       BatchIncident[]    @relation("ResolvedIncidents")
  purchaseRequisitions    PurchaseRequisition[] @relation("UserPurchaseRequisitions")
  directPayments          DirectPayment[]
  labAreas                UserLabArea[]
  labRequestsCreated      LabInternalRequest[]     @relation("LabRequestsRequested")
  labRequestsReviewed     LabInternalRequest[]     @relation("LabRequestsReviewed")
  weeklyRunsExecuted      LabWeeklyRun[]           @relation("UserWeeklyRuns")
  consumptionAuditLogs    LabConsumptionAuditLog[]
  projectMemberships      ResearchProjectMember[]
  donationsReceived       ResearchDonation[]       @relation("DonationsReceived")
  transfersAuthorized     ResearchStockTransfer[]  @relation("TransfersAuthorized")
  trialsExecuted          ResearchTrial[]          @relation("UserResearchTrials")
  findingsRecorded        ResearchFinding[]        @relation("UserResearchFindings")
  fridgePhysicalAudits    FridgePhysicalAudit[]

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ==========================================
// 3. MONEDAS Y TASAS DE CAMBIO
// ==========================================

model Currency {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  symbol    String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  exchanges CurrencyExchange[]
  orders    Order[]
  payments  OrderPayment[]

  @@map("currencies")
}

model CurrencyExchange {
  id            BigInt   @id @default(autoincrement())
  currencyId    Int      @map("currency_id")
  rate          Decimal  @db.Decimal(18, 4)
  effectiveDate DateTime @map("effective_date") @db.Date
  createdById   Int      @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  currency  Currency @relation(fields: [currencyId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@map("currency_exchanges")
}

// ==========================================
// 4. ESTRUCTURA ORGANIZACIONAL Y CATÁLOGO
// ==========================================

model Department {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requests             Request[]
  purchaseRequisitions PurchaseRequisition[]

  @@map("departments")
}

model Category {
  id          Int       @id @default(autoincrement())
  code        String?   @unique
  name        String    @unique
  description String?
  products    Product[]

  @@map("categories")
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  description String?
  products Product[]

  @@map("brands")
}

model Unit {
  id           Int       @id @default(autoincrement())
  name         String
  abbreviation String    @unique
  baseProducts Product[] @relation("BaseUnitRelation")
  purchProducts Product[] @relation("PurchaseUnitRelation")
  orderItems   OrderItem[]
  purchaseRequisitionItems PurchaseRequisitionItem[]

  @@map("units")
}

model Supplier {
  id          Int      @id @default(autoincrement())
  rifOrId     String   @unique @map("rif_or_id")
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("suppliers")
}

model Product {
  id               BigInt   @id @default(autoincrement())
  categoryId       Int      @map("category_id")
  brandId          Int?     @map("brand_id")
  baseUnitId       Int      @map("base_unit_id")
  purchaseUnitId   Int?     @map("purchase_unit_id")
  conversionFactor Decimal  @default(1.00) @map("conversion_factor") @db.Decimal(10, 2)
  name             String
  sku              String   @unique
  barcode          String?  @unique
  description      String?  @db.Text
  isTaxExempt      Boolean  @default(false) @map("is_tax_exempt")
  minStockAlert    Int      @default(0) @map("min_stock_alert")
  isReagent        Boolean  @default(false) @map("is_reagent")
  isLabReagent     Boolean  @default(false) @map("is_lab_reagent")
  labItemType      LabItemType? @map("lab_item_type")
  theoreticalYield Int?     @map("theoretical_yield")
  includesCalibrator Boolean @default(false) @map("includes_calibrator")
  calibratorsPerRun Int?    @map("calibrators_per_run")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category        Category         @relation(fields: [categoryId], references: [id])
  brand           Brand?           @relation(fields: [brandId], references: [id])
  baseUnit        Unit             @relation("BaseUnitRelation", fields: [baseUnitId], references: [id])
  purchaseUnit    Unit?            @relation("PurchaseUnitRelation", fields: [purchaseUnitId], references: [id])
  orderItems      OrderItem[]
  stockBatches    StockBatch[]
  labReagentUnits LabReagentUnit[]
  requestItems    RequestItem[]
  purchaseRequisitionItems PurchaseRequisitionItem[]
  stockMovements  StockMovement[]
  allowedLabAreas LabAreaProduct[]
  compatibleExams LabExamProduct[]
  internalRequestItems LabInternalRequestItem[]
  donationItems ResearchDonationItem[]

  @@map("products")
}

// ==========================================
// 5. INFRAESTRUCTURA FÍSICA
// ==========================================

model Location {
  id          Int          @id @default(autoincrement())
  name        String
  type        LocationType
  description String?

  fridges                 Fridge[]
  stockBatches            StockBatch[]
  originStockMovements    StockMovement[] @relation("OriginLocation")
  destStockMovements      StockMovement[] @relation("DestinationLocation")

  @@map("locations")
}

model Fridge {
  id                Int          @id @default(autoincrement())
  locationId        Int          @map("location_id")
  code              String       @unique
  name              String
  targetTempCelsius Decimal?     @map("target_temp_celsius") @db.Decimal(5, 2)
  status            FridgeStatus @default(OPERATIVO)
  description       String?

  location         Location           @relation(fields: [locationId], references: [id])
  labReagentUnits  LabReagentUnit[]
  originTransfers  LabStockMovement[] @relation("FromFridge")
  destTransfers    LabStockMovement[] @relation("ToFridge")

  @@map("fridges")
}

// ==========================================
// 6. COMPRAS, PAGOS Y FACTURACIÓN
// ==========================================

model Order {
  id              BigInt          @id @default(autoincrement())
  orderNumber     String          @unique @map("order_number")
  supplierId      Int?            @map("supplier_id")
  currency        String          @default("USD")
  currencyId      Int             @default(1) @map("currency_id")
  exchangeRate    Decimal         @map("exchange_rate") @db.Decimal(18, 4)
  status          OrderStatus     @default(BORRADOR)
  paymentStatus   PaymentStatus   @default(PENDIENTE) @map("payment_status")
  receptionStatus ReceptionStatus @default(PENDIENTE) @map("reception_status")
  subtotal        Decimal         @db.Decimal(18, 2)
  taxTotal        Decimal         @map("tax_total") @db.Decimal(18, 2)
  total           Decimal         @db.Decimal(18, 2)
  taxableAmount   Decimal         @default(0.00) @map("taxable_amount") @db.Decimal(18, 2)
  exemptAmount    Decimal         @default(0.00) @map("exempt_amount") @db.Decimal(18, 2)
  taxAmount       Decimal         @default(0.00) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount     Decimal         @default(0.00) @map("total_amount") @db.Decimal(18, 2)
  taxableAmountUsd Decimal         @default(0.00) @map("taxable_amount_usd") @db.Decimal(18, 2)
  exemptAmountUsd  Decimal         @default(0.00) @map("exempt_amount_usd") @db.Decimal(18, 2)
  taxAmountUsd     Decimal         @default(0.00) @map("tax_amount_usd") @db.Decimal(18, 2)
  totalAmountUsd   Decimal         @default(0.00) @map("total_amount_usd") @db.Decimal(18, 2)
  totalAmountBs    Decimal         @default(0.00) @map("total_amount_bs") @db.Decimal(18, 2)
  requisitionId    BigInt?         @map("requisition_id")
  notes           String?         @db.Text
  createdById     Int             @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  supplier       Supplier?            @relation(fields: [supplierId], references: [id])
  currencyRel    Currency             @relation(fields: [currencyId], references: [id])
  createdBy      User                 @relation(fields: [createdById], references: [id])
  requisition    PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  items          OrderItem[]
  payments       OrderPayment[]
  invoices       OrderInvoice[]
  stockMovements StockMovement[]

  @@map("orders")
}

model OrderItem {
  id               BigInt   @id @default(autoincrement())
  orderId          BigInt   @map("order_id")
  productId        BigInt   @map("product_id")
  unitId           Int      @map("unit_id")
  quantityOrdered  Decimal  @map("quantity_ordered") @db.Decimal(12, 2)
  quantityReceived Decimal  @default(0) @map("quantity_received") @db.Decimal(12, 2)
  quantityRejected Decimal  @default(0) @map("quantity_rejected") @db.Decimal(12, 2)
  multiplier       Decimal  @default(1.00) @map("multiplier") @db.Decimal(10, 2)
  baseQuantity     Decimal  @map("base_quantity") @db.Decimal(12, 2)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(18, 4)
  taxRate          Decimal  @default(16.00) @map("tax_rate") @db.Decimal(5, 2)
  isExempt         Boolean  @default(false) @map("is_exempt")
  totalLine        Decimal  @map("total_line") @db.Decimal(18, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])
  stockMovementItems StockMovementItem[]

  @@map("order_items")
}

model BankAccount {
  id            Int            @id @default(autoincrement())
  bankName      String         @map("bank_name")
  accountNumber String?        @map("account_number")
  type          String         @default("CORRIENTE") // 'CORRIENTE', 'CUSTODIA', 'EFECTIVO'
  currency      String         @default("USD") // 'USD', 'EUR', 'VED'
  holderName    String         @map("holder_name")
  holderId      String         @map("holder_id")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  payments       OrderPayment[]
  directPayments DirectPayment[]

  @@map("bank_accounts")
}

model OrderPayment {
  id                  BigInt        @id @default(autoincrement())
  orderId             BigInt        @map("order_id")
  method              String        @default("TRANSFERENCIA")
  paymentMethod       PaymentMethod @default(TRANSFERENCIA_NACIONAL) @map("payment_method")
  sourceAccountId     Int?          @map("source_account_id")
  destinationAccount  String?       @map("destination_account")
  bankName            String?       @map("bank_name")
  referenceNumber     String?       @map("reference_number")
  currencyId          Int?          @default(1) @map("currency_id")
  transactionCurrency String        @default("USD") @map("transaction_currency")
  exchangeRate        Decimal       @default(1.0000) @map("exchange_rate") @db.Decimal(18, 4)
  amount              Decimal       @db.Decimal(18, 2)
  amountPaid          Decimal       @default(0.00) @map("amount_paid") @db.Decimal(18, 2)
  amortizedAmountUsd  Decimal       @default(0.00) @map("amortized_amount_usd") @db.Decimal(18, 2)
  paymentDate         DateTime      @map("payment_date")
  receiptImageUrl     String?       @map("receipt_image_url")
  reviewedBy          String?       @map("reviewed_by")
  authorizedBy        String?       @map("authorized_by")
  approvedBy          String?       @map("approved_by")
  registeredById      Int           @map("registered_by_id")
  createdAt           DateTime      @default(now()) @map("created_at")

  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceAccount BankAccount? @relation(fields: [sourceAccountId], references: [id])
  currency      Currency?    @relation(fields: [currencyId], references: [id])
  registeredBy  User         @relation(fields: [registeredById], references: [id])

  @@map("order_payments")
}

model DirectPayment {
  id                  BigInt        @id @default(autoincrement())
  concept             String
  beneficiary         String
  method              String        @default("TRANSFERENCIA")
  sourceAccountId     Int?          @map("source_account_id")
  destinationAccount  String?       @map("destination_account")
  referenceNumber     String?       @map("reference_number")
  paymentDate         DateTime      @default(now()) @map("payment_date")
  amountPaid          Decimal       @map("amount_paid") @db.Decimal(18, 2)
  transactionCurrency String        @default("USD") @map("transaction_currency")
  exchangeRate        Decimal       @default(1.0000) @map("exchange_rate") @db.Decimal(18, 4)
  equivalentAmountUsd Decimal       @default(0.00) @map("equivalent_amount_usd") @db.Decimal(18, 2)
  notes               String?
  receiptImageUrl     String?       @map("receipt_image_url")
  reviewedBy          String?       @map("reviewed_by")
  authorizedBy        String?       @map("authorized_by")
  approvedBy          String?       @map("approved_by")
  registeredById      Int           @map("registered_by_id")
  createdAt           DateTime      @default(now()) @map("created_at")

  sourceAccount BankAccount? @relation(fields: [sourceAccountId], references: [id])
  registeredBy  User         @relation(fields: [registeredById], references: [id])

  @@map("direct_payments")
}

model OrderInvoice {
  id            BigInt    @id @default(autoincrement())
  orderId       BigInt    @map("order_id")
  invoiceNumber String    @map("invoice_number")
  controlNumber String?   @map("control_number")
  invoiceDate   DateTime  @map("invoice_date") @db.Date
  fileUrl       String?   @map("file_url")
  taxAmount     Decimal   @map("tax_amount") @db.Decimal(18, 2)
  totalAmount   Decimal   @map("total_amount") @db.Decimal(18, 2)
  createdAt     DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_invoices")
}

model PurchaseRequisition {
  id                BigInt                    @id @default(autoincrement())
  requisitionNumber String                    @unique @map("requisition_number")
  departmentId      Int                       @map("department_id")
  departmentSection String?                   @map("department_section")
  justification     String                    @db.Text
  status            PurchaseRequisitionStatus @default(BORRADOR)
  notes             String?                   @db.Text
  createdById       Int                       @map("created_by_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  department        Department                @relation(fields: [departmentId], references: [id])
  createdBy         User                      @relation("UserPurchaseRequisitions", fields: [createdById], references: [id])
  items             PurchaseRequisitionItem[]
  orders            Order[]

  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                BigInt  @id @default(autoincrement())
  requisitionId     BigInt  @map("requisition_id")
  productId         BigInt  @map("product_id")
  unitId            Int     @map("unit_id")
  quantityRequested Decimal @map("quantity_requested") @db.Decimal(12, 2)
  estimatedPrice    Decimal? @map("estimated_price") @db.Decimal(18, 4)

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id])
  unit        Unit                @relation(fields: [unitId], references: [id])

  @@map("purchase_requisition_items")
}

// ==========================================
// 7. STOCK CENTRAL Y MOVIMIENTOS
// ==========================================

model StockBatch {
  id              BigInt      @id @default(autoincrement())
  productId       BigInt      @map("product_id")
  locationId      Int         @map("location_id")
  lotNumber       String      @map("lot_number")
  currentQuantity Decimal     @map("current_quantity") @db.Decimal(12, 2)
  costPrice       Decimal     @map("cost_price") @db.Decimal(18, 4)
  expirationDate  DateTime?   @map("expiration_date") @db.Date
  status          BatchStatus    @default(DISPONIBLE)
  origin          String?        @default("ORDEN_COMPRA") @map("origin")
  ownershipType   StockOwnership @default(CLINICAL_ROUTINE) @map("ownership_type")
  researchProjectId Int?         @map("research_project_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  product            Product              @relation(fields: [productId], references: [id])
  location           Location             @relation(fields: [locationId], references: [id])
  researchProject    ResearchProject?     @relation(fields: [researchProjectId], references: [id], onDelete: SetNull)
  movementItems      StockMovementItem[]
  labReagentUnits    LabReagentUnit[]
  incidents          BatchIncident[]
  donationItems      ResearchDonationItem[]

  @@index([productId, lotNumber, locationId])
  @@map("stock_batches")
}

model StockMovement {
  id                    BigInt            @id @default(autoincrement())
  referenceNumber       String            @unique @map("reference_number")
  type                  StockMovementType
  orderId               BigInt?           @map("order_id")
  originLocationId      Int?              @map("origin_location_id")
  destinationLocationId Int?              @map("destination_location_id")
  notes                 String?           @db.Text
  createdById           Int               @map("created_by_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  productId             BigInt?           @map("product_id")

  product             Product?            @relation(fields: [productId], references: [id])
  order               Order?              @relation(fields: [orderId], references: [id])
  originLocation      Location?           @relation("OriginLocation", fields: [originLocationId], references: [id])
  destinationLocation Location?           @relation("DestinationLocation", fields: [destinationLocationId], references: [id])
  createdBy           User                @relation(fields: [createdById], references: [id])
  items               StockMovementItem[]
  requests            Request[]

  @@map("stock_movements")
}

model StockMovementItem {
  id              BigInt      @id @default(autoincrement())
  stockMovementId BigInt      @map("stock_movement_id")
  batchId         BigInt?     @map("batch_id")
  orderItemId     BigInt?     @map("order_item_id")
  quantity        Decimal     @db.Decimal(12, 2)
  unitCost        Decimal?    @map("unit_cost") @db.Decimal(18, 4)

  stockMovement StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Cascade)
  batch         StockBatch?   @relation(fields: [batchId], references: [id])
  orderItem     OrderItem?    @relation(fields: [orderItemId], references: [id])

  @@map("stock_movement_items")
}

// ==========================================
// 8. LABORATORIO (NEVERA, CAVA Y REACTIVOS)
// ==========================================

model LabReagentUnit {
  id             BigInt        @id @default(autoincrement())
  productId      BigInt        @map("product_id")
  batchId        BigInt        @map("batch_id")
  fridgeId       Int?          @map("fridge_id")
  unitCode       String        @unique @map("unit_code")
  initialVolume  Decimal       @map("initial_volume") @db.Decimal(12, 2)
  currentVolume  Decimal       @map("current_volume") @db.Decimal(12, 2)
  status                 LabUnitStatus  @default(SELLADO)
  ownershipType          StockOwnership @default(CLINICAL_ROUTINE) @map("ownership_type")
  researchProjectId      Int?           @map("research_project_id")
  initialTheoreticalUses Int            @default(0) @map("initial_theoretical_uses")
  consumedUses           Int            @default(0) @map("consumed_uses")
  remainingUses          Int            @default(0) @map("remaining_uses")
  yieldVariance          Int            @default(0) @map("yield_variance")
  unitCostPerUse         Decimal        @default(0.0000) @map("unit_cost_per_use") @db.Decimal(18, 4)
  referenceCostPerUse    Decimal?       @map("reference_cost_per_use") @db.Decimal(18, 4)
  assignedLabAreaId      Int?           @map("assigned_lab_area_id")
  openedAt               DateTime?      @map("opened_at")
  openedById     Int?          @map("opened_by_id")
  expirationDate DateTime?     @map("expiration_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  product                     Product                  @relation(fields: [productId], references: [id])
  batch                       StockBatch               @relation(fields: [batchId], references: [id])
  fridge                      Fridge?                  @relation(fields: [fridgeId], references: [id])
  assignedLabArea             LabArea?                 @relation("AssignedLabUnits", fields: [assignedLabAreaId], references: [id], onDelete: SetNull)
  openedBy                    User?                    @relation("LabUnitOpenedBy", fields: [openedById], references: [id])
  researchProject             ResearchProject?         @relation(fields: [researchProjectId], references: [id], onDelete: SetNull)
  movements                   LabStockMovement[]
  incidents                   BatchIncident[]
  internalRequestItems        LabInternalRequestItem[]
  runConsumptionsAsPrimary    LabRunConsumption[]      @relation("PrimaryReagentConsumptions")
  runConsumptionsAsCalibrator LabRunConsumption[]      @relation("ExternalCalibratorConsumptions")
  trialConsumptionsAsPrimary  ResearchTrialConsumption[] @relation("PrimaryReagentTrialConsumptions")
  trialConsumptionsAsCalibrator ResearchTrialConsumption[] @relation("ExternalCalibratorTrialConsumptions")
  stockTransfersSource        ResearchStockTransfer[]  @relation("TransferSourceUnit")
  stockTransfersTarget        ResearchStockTransfer[]  @relation("TransferTargetUnit")
  donationItems               ResearchDonationItem[]
  consumptionAuditLogs        LabConsumptionAuditLog[]
  fridgePhysicalAuditItems    FridgePhysicalAuditItem[]

  @@map("lab_reagent_units")
}

model LabStockMovement {
  id               BigInt          @id @default(autoincrement())
  labReagentUnitId BigInt          @map("lab_reagent_unit_id")
  movementType     LabMovementType @map("movement_type")
  amountUsed       Decimal         @map("amount_used") @db.Decimal(12, 2)
  fromFridgeId     Int?            @map("from_fridge_id")
  toFridgeId       Int?            @map("to_fridge_id")
  reason           String?
  executedById     Int             @map("executed_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")

  labReagentUnit LabReagentUnit @relation(fields: [labReagentUnitId], references: [id], onDelete: Cascade)
  fromFridge     Fridge?        @relation("FromFridge", fields: [fromFridgeId], references: [id])
  toFridge       Fridge?        @relation("ToFridge", fields: [toFridgeId], references: [id])
  executedBy     User           @relation(fields: [executedById], references: [id])

  @@map("lab_stock_movements")
}

// ==========================================
// 9. SOLICITUDES INTERNAS (REQUESTS)
// ==========================================

model Request {
  id                  BigInt        @id @default(autoincrement())
  requestNumber       String        @unique @map("request_number")
  userId              Int           @map("user_id")
  status              RequestStatus @default(PENDIENTE)
  priority            RequestPriority @default(RUTINA)
  departmentId        Int           @map("department_id")
  departmentSection   String?       @map("department_section")
  justification       String        @db.Text
  weeklyTokenCycle    String        @map("weekly_token_cycle")
  dispatchedMovementId BigInt?      @map("dispatched_movement_id")
  approvedById        Int?          @map("approved_by_id")
  approvedAt          DateTime?     @map("approved_at")
  notes               String?       @db.Text
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  department         Department     @relation(fields: [departmentId], references: [id])
  user               User           @relation("UserRequests", fields: [userId], references: [id])
  approvedBy         User?          @relation("UserApprovedRequests", fields: [approvedById], references: [id])
  dispatchedMovement StockMovement? @relation(fields: [dispatchedMovementId], references: [id])
  items              RequestItem[]

  @@map("requests")
}

model RequestItem {
  id                BigInt  @id @default(autoincrement())
  requestId         BigInt  @map("request_id")
  productId         BigInt  @map("product_id")
  quantityRequested Decimal @map("quantity_requested") @db.Decimal(12, 2)
  quantityApproved  Decimal @default(0) @map("quantity_approved") @db.Decimal(12, 2)
  quantityDispatched Decimal @default(0) @map("quantity_dispatched") @db.Decimal(12, 2)

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("request_items")
}

// ==========================================
// 10. INCIDENCIAS TÉCNICAS (DEFECTUOSOS / MERMAS)
// ==========================================

model BatchIncident {
  id               BigInt                     @id @default(autoincrement())
  batchId          BigInt?                    @map("batch_id")
  labReagentUnitId BigInt?                    @map("lab_reagent_unit_id")
  labAreaId        Int?                       @map("lab_area_id")
  reportedById     Int                        @map("reported_by_id")
  incidentType     IncidentType               @map("incident_type")
  instanceType     QuarantineInstanceType     @default(RECEPTION_PURCHASING) @map("instance_type")
  quarantineReason QuarantineReason?          @map("quarantine_reason")
  description      String                     @db.Text
  evidenceUrl      String?                    @map("evidence_url")
  affectedQuantity Decimal                    @default(0.00) @map("affected_quantity") @db.Decimal(12, 2)
  affectedUses     Int?                       @default(0) @map("affected_uses")
  status           IncidentStatus             @default(ABIERTA)
  resolutionStatus QuarantineResolutionStatus @default(PENDING) @map("resolution_status")
  resolvedById     Int?                       @map("resolved_by_id")
  resolutionNotes  String?                    @map("resolution_notes") @db.Text
  resolvedAt       DateTime?                  @map("resolved_at")
  createdAt        DateTime                   @default(now()) @map("created_at")

  batch          StockBatch?     @relation(fields: [batchId], references: [id])
  labReagentUnit LabReagentUnit? @relation(fields: [labReagentUnitId], references: [id], onDelete: SetNull)
  labArea        LabArea?        @relation(fields: [labAreaId], references: [id], onDelete: SetNull)
  reportedBy     User            @relation("ReportedIncidents", fields: [reportedById], references: [id])
  resolvedBy     User?           @relation("ResolvedIncidents", fields: [resolvedById], references: [id])

  @@map("batch_incidents")
}

// ==========================================
// 11. CONFIGURACIÓN DE VENTANA OPERATIVA (REQUESTS)
// ==========================================

model RequestWindowConfig {
  id                        Int      @id @default(autoincrement())
  startDay                  Int      @default(1) @map("start_day") // 1 = Lunes
  startHour                 Int      @default(5) @map("start_hour") // 05:00 AM
  startMinute               Int      @default(0) @map("start_minute")
  endDay                    Int      @default(3) @map("end_day") // 3 = Miércoles
  endHour                   Int      @default(16) @map("end_hour") // 16:00 (04:00 PM)
  endMinute                 Int      @default(0) @map("end_minute")
  isSuspended               Boolean  @default(false) @map("is_suspended")
  maxWeeklyRequestsPerUser  Int      @default(1) @map("max_weekly_requests_per_user")
  timezone                  String   @default("America/Caracas")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("request_window_configs")
}

// ==========================================
// 12. MAESTROS DE ALMACÉN: MÉTODOS DE PAGO Y PROTOCOLOS
// ==========================================

model PaymentMethodCatalog {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("payment_methods_catalog")
}

model JustificationConcept {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  title       String
  description String?  @db.Text
  category    String   @default("COMPRA") // 'COMPRA', 'SOLICITUD', 'AJUSTE', 'GENERAL'
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("justification_concepts")
}

// ==========================================
// 13. ÁREAS DE LABORATORIO Y CATÁLOGO DE EXÁMENES
// ==========================================

model LabArea {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users                UserLabArea[]
  exams                LabExam[]
  products             LabAreaProduct[]
  incidents            BatchIncident[]
  assignedUnits        LabReagentUnit[]         @relation("AssignedLabUnits")
  internalRequests     LabInternalRequest[]
  weeklyRuns           LabWeeklyRun[]
  consumptionAuditLogs LabConsumptionAuditLog[]

  @@map("lab_areas")
}

model UserLabArea {
  userId    Int      @map("user_id")
  labAreaId Int      @map("lab_area_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  labArea LabArea @relation(fields: [labAreaId], references: [id], onDelete: Cascade)

  @@id([userId, labAreaId])
  @@map("user_lab_areas")
}

model LabExam {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?  @db.Text
  areaId      Int?     @map("area_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  area                 LabArea?                 @relation(fields: [areaId], references: [id], onDelete: SetNull)
  compatibleProducts   LabExamProduct[]
  weeklyRuns           LabWeeklyRun[]
  consumptionAuditLogs LabConsumptionAuditLog[]

  @@map("lab_exams")
}

model LabAreaProduct {
  labAreaId Int     @map("lab_area_id")
  productId BigInt  @map("product_id")

  labArea LabArea @relation(fields: [labAreaId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([labAreaId, productId])
  @@map("lab_area_products")
}

model LabExamProduct {
  labExamId Int     @map("lab_exam_id")
  productId BigInt  @map("product_id")

  labExam LabExam @relation(fields: [labExamId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([labExamId, productId])
  @@map("lab_exam_products")
}

// ==========================================
// 14. SOLICITUDES INTERNAS, CORRIDAS SEMANALES Y AUDITORÍA 5D (FASE 2)
// ==========================================

model LabInternalRequest {
  id            Int                      @id @default(autoincrement())
  code          String                   @unique
  labAreaId     Int                      @map("lab_area_id")
  requestedById Int                      @map("requested_by_id")
  reviewedById  Int?                     @map("reviewed_by_id")
  status        LabInternalRequestStatus @default(PENDING)
  justification String                   @db.Text
  reviewNotes   String?                  @map("review_notes") @db.Text
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  resolvedAt    DateTime?                @map("resolved_at")

  labArea     LabArea                  @relation(fields: [labAreaId], references: [id])
  requestedBy User                     @relation("LabRequestsRequested", fields: [requestedById], references: [id])
  reviewedBy  User?                    @relation("LabRequestsReviewed", fields: [reviewedById], references: [id])
  items       LabInternalRequestItem[]

  @@map("lab_internal_requests")
}

model LabInternalRequestItem {
  id                   Int     @id @default(autoincrement())
  requestId            Int     @map("request_id")
  productId            BigInt  @map("product_id")
  requestedUsesOrUnits Int     @map("requested_uses_or_units")
  assignedLabUnitId    BigInt? @map("assigned_lab_unit_id")

  request         LabInternalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product         Product            @relation(fields: [productId], references: [id])
  assignedLabUnit LabReagentUnit?    @relation(fields: [assignedLabUnitId], references: [id], onDelete: SetNull)

  @@map("lab_internal_request_items")
}

model LabWeeklyRun {
  id                     Int                @id @default(autoincrement())
  code                   String             @unique
  labAreaId              Int                @map("lab_area_id")
  labExamId              Int                @map("lab_exam_id")
  bioanalystId           Int                @map("bioanalyst_id")
  weekStartDate          DateTime           @map("week_start_date")
  weekEndDate            DateTime           @map("week_end_date")
  status                 LabWeeklyRunStatus @default(OPEN_ACCUMULATING)
  totalValidPatientExams Int                @default(0) @map("total_valid_patient_exams")
  totalRunCost           Decimal            @default(0.0000) @map("total_run_cost") @db.Decimal(18, 4)
  effectiveCostPerExam   Decimal            @default(0.0000) @map("effective_cost_per_exam") @db.Decimal(18, 4)
  notes                  String?            @db.Text
  closedAt               DateTime?          @map("closed_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  labArea      LabArea                  @relation(fields: [labAreaId], references: [id])
  labExam      LabExam                  @relation(fields: [labExamId], references: [id])
  bioanalyst   User                     @relation("UserWeeklyRuns", fields: [bioanalystId], references: [id])
  consumptions LabRunConsumption[]
  auditLogs    LabConsumptionAuditLog[]

  @@map("lab_weekly_runs")
}

model LabRunConsumption {
  id                        Int           @id @default(autoincrement())
  runId                     Int           @map("run_id")
  labReagentUnitId          BigInt        @map("lab_reagent_unit_id")
  externalCalibratorUnitId  BigInt?       @map("external_calibrator_unit_id")
  patientUses               Int           @default(0) @map("patient_uses")
  repeatUses                Int           @default(0) @map("repeat_uses")
  repeatReason              RepeatReason? @map("repeat_reason")
  calibratorUses            Int           @default(0) @map("calibrator_uses")
  calibratorNotes           String?       @map("calibrator_notes")
  controlUses               Int           @default(0) @map("control_uses")
  wasteUses                 Int           @default(0) @map("waste_uses")
  totalDeductedUses         Int           @default(0) @map("total_deducted_uses")
  calculatedCost            Decimal       @default(0.0000) @map("calculated_cost") @db.Decimal(18, 4)

  run                    LabWeeklyRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  labReagentUnit         LabReagentUnit  @relation("PrimaryReagentConsumptions", fields: [labReagentUnitId], references: [id])
  externalCalibratorUnit LabReagentUnit? @relation("ExternalCalibratorConsumptions", fields: [externalCalibratorUnitId], references: [id], onDelete: SetNull)

  @@map("lab_run_consumptions")
}

model LabConsumptionAuditLog {
  id               BigInt             @id @default(autoincrement())
  userId           Int                @map("user_id")
  labAreaId        Int?               @map("lab_area_id")
  researchTrialId  Int?               @map("research_trial_id")
  labExamId        Int?               @map("lab_exam_id")
  weeklyRunId      Int?               @map("weekly_run_id")
  labReagentUnitId BigInt             @map("lab_reagent_unit_id")
  concept          ConsumptionConcept
  usesCount        Int                @map("uses_count")
  costImpact       Decimal            @default(0.0000) @map("cost_impact") @db.Decimal(18, 4)
  notes            String?            @db.Text
  createdAt        DateTime           @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id])
  labArea        LabArea?       @relation(fields: [labAreaId], references: [id], onDelete: SetNull)
  researchTrial  ResearchTrial? @relation(fields: [researchTrialId], references: [id], onDelete: SetNull)
  labExam        LabExam?       @relation(fields: [labExamId], references: [id], onDelete: SetNull)
  weeklyRun      LabWeeklyRun?  @relation(fields: [weeklyRunId], references: [id], onDelete: SetNull)
  labReagentUnit LabReagentUnit @relation(fields: [labReagentUnitId], references: [id])

  @@index([labReagentUnitId, createdAt])
  @@index([labAreaId, concept])
  @@index([researchTrialId])
  @@map("lab_consumption_audit_logs")
}

// ==========================================
// 15. MÓDULO DE INVESTIGACIÓN Y DOCENCIA (FASE 3)
// ==========================================

model ResearchProject {
  id                     Int                   @id @default(autoincrement())
  code                   String                @unique
  title                  String
  description            String?               @db.Text
  researchLine           String?               @map("research_line")
  type                   ResearchProjectType
  status                 ResearchProjectStatus @default(FORMULATION)
  startDate              DateTime?             @map("start_date")
  endDate                DateTime?             @map("end_date")
  totalInvestedFunds     Decimal               @default(0.0000) @map("total_invested_funds") @db.Decimal(18, 4)
  spentFunds             Decimal               @default(0.0000) @map("spent_funds") @db.Decimal(18, 4)
  remainingFunds         Decimal               @default(0.0000) @map("remaining_funds") @db.Decimal(18, 4)
  consumedMaterialsValue Decimal               @default(0.0000) @map("consumed_materials_value") @db.Decimal(18, 4)
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  members                ResearchProjectMember[]
  investments            ResearchInvestment[]
  donations              ResearchDonation[]
  stockTransfers         ResearchStockTransfer[]
  trials                 ResearchTrial[]
  findings               ResearchFinding[]
  stockBatches           StockBatch[]
  labReagentUnits        LabReagentUnit[]

  @@map("research_projects")
}

model ResearchProjectMember {
  id                  Int                @id @default(autoincrement())
  projectId           Int                @map("project_id")
  userId              Int                @map("user_id")
  role                ResearchMemberRole
  canRequestMaterials Boolean            @default(true) @map("can_request_materials")
  canRecordTrials     Boolean            @default(true) @map("can_record_trials")
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at")

  project             ResearchProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("research_project_members")
}

model ResearchInvestor {
  id           Int                  @id @default(autoincrement())
  name         String
  taxIdOrCode  String?              @unique @map("tax_id_or_code")
  investorType ResearchInvestorType @map("investor_type")
  contactName  String?              @map("contact_name")
  contactEmail String?              @map("contact_email")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  investments  ResearchInvestment[]
  donations    ResearchDonation[]

  @@map("research_investors")
}

model ResearchInvestment {
  id             Int              @id @default(autoincrement())
  code           String           @unique
  projectId      Int              @map("project_id")
  investorId     Int              @map("investor_id")
  amount         Decimal          @db.Decimal(18, 4)
  currency       String           @default("USD")
  investmentDate DateTime         @map("investment_date")
  purposeNotes   String?          @map("purpose_notes") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")

  project        ResearchProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investor       ResearchInvestor @relation(fields: [investorId], references: [id])

  @@map("research_investments")
}

model ResearchDonation {
  id           Int                    @id @default(autoincrement())
  code         String                 @unique
  projectId    Int                    @map("project_id")
  investorId   Int                    @map("investor_id")
  receivedById Int                    @map("received_by_id")
  donationDate DateTime               @map("donation_date")
  notes        String?                @db.Text
  createdAt    DateTime               @default(now()) @map("created_at")

  project      ResearchProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investor     ResearchInvestor       @relation(fields: [investorId], references: [id])
  receivedBy   User                   @relation("DonationsReceived", fields: [receivedById], references: [id])
  items        ResearchDonationItem[]

  @@map("research_donations")
}

model ResearchDonationItem {
  id                 Int               @id @default(autoincrement())
  donationId         Int               @map("donation_id")
  productId          BigInt            @map("product_id")
  quantity           Int
  lotNumber          String            @map("lot_number")
  expirationDate     DateTime?         @map("expiration_date") @db.Date
  estimatedUnitValue Decimal           @map("estimated_unit_value") @db.Decimal(18, 4)
  stockBatchId       BigInt?           @map("stock_batch_id")
  labReagentUnitId   BigInt?           @map("lab_reagent_unit_id")

  donation           ResearchDonation  @relation(fields: [donationId], references: [id], onDelete: Cascade)
  product            Product           @relation(fields: [productId], references: [id])
  stockBatch         StockBatch?       @relation(fields: [stockBatchId], references: [id], onDelete: SetNull)
  labReagentUnit     LabReagentUnit?   @relation(fields: [labReagentUnitId], references: [id], onDelete: SetNull)

  @@map("research_donation_items")
}

model ResearchStockTransfer {
  id              Int                       @id @default(autoincrement())
  sourceUnitId    BigInt                    @map("source_unit_id")
  targetUnitId    BigInt?                   @map("target_unit_id")
  projectId       Int                       @map("project_id")
  authorizedById  Int                       @map("authorized_by_id")
  transferredUses Int                       @map("transferred_uses")
  direction       ResearchTransferDirection
  reason          String                    @db.Text
  createdAt       DateTime                  @default(now()) @map("created_at")

  sourceUnit      LabReagentUnit            @relation("TransferSourceUnit", fields: [sourceUnitId], references: [id])
  targetUnit      LabReagentUnit?           @relation("TransferTargetUnit", fields: [targetUnitId], references: [id], onDelete: SetNull)
  project         ResearchProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorizedBy    User                      @relation("TransfersAuthorized", fields: [authorizedById], references: [id])

  @@map("research_stock_transfers")
}

model ResearchTrial {
  id                  Int                        @id @default(autoincrement())
  code                String                     @unique
  projectId           Int                        @map("project_id")
  executedById        Int                        @map("executed_by_id")
  trialDate           DateTime                   @map("trial_date")
  title               String
  objective           String?                    @db.Text
  status              ResearchTrialStatus        @default(OPEN)
  totalSamplesTested  Int                        @default(0) @map("total_samples_tested")
  totalTrialCost      Decimal                    @default(0.0000) @map("total_trial_cost") @db.Decimal(18, 4)
  totalReferenceValue Decimal                    @default(0.0000) @map("total_reference_value") @db.Decimal(18, 4)
  notes               String?                    @db.Text
  completedAt         DateTime?                  @map("completed_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  project             ResearchProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executedBy          User                       @relation("UserResearchTrials", fields: [executedById], references: [id])
  consumptions        ResearchTrialConsumption[]
  findings            ResearchFinding[]
  auditLogs           LabConsumptionAuditLog[]

  @@map("research_trials")
}

model ResearchTrialConsumption {
  id                       Int             @id @default(autoincrement())
  trialId                  Int             @map("trial_id")
  labReagentUnitId         BigInt          @map("lab_reagent_unit_id")
  externalCalibratorUnitId BigInt?         @map("external_calibrator_unit_id")
  sampleUses               Int             @default(0) @map("sample_uses")
  repeatUses               Int             @default(0) @map("repeat_uses")
  repeatReason             RepeatReason?   @map("repeat_reason")
  calibratorUses           Int             @default(0) @map("calibrator_uses")
  calibratorNotes          String?         @map("calibrator_notes")
  controlUses              Int             @default(0) @map("control_uses")
  wasteUses                Int             @default(0) @map("waste_uses")
  totalDeductedUses        Int             @default(0) @map("total_deducted_uses")
  calculatedCost           Decimal         @default(0.0000) @map("calculated_cost") @db.Decimal(18, 4)
  calculatedReferenceValue Decimal         @default(0.0000) @map("calculated_reference_value") @db.Decimal(18, 4)

  trial                    ResearchTrial   @relation(fields: [trialId], references: [id], onDelete: Cascade)
  labReagentUnit           LabReagentUnit  @relation("PrimaryReagentTrialConsumptions", fields: [labReagentUnitId], references: [id])
  externalCalibratorUnit   LabReagentUnit? @relation("ExternalCalibratorTrialConsumptions", fields: [externalCalibratorUnitId], references: [id], onDelete: SetNull)

  @@map("research_trial_consumptions")
}

model ResearchFinding {
  id            Int                 @id @default(autoincrement())
  projectId     Int                 @map("project_id")
  trialId       Int?                @map("trial_id")
  recordedById  Int                 @map("recorded_by_id")
  title         String
  findingType   ResearchFindingType @map("finding_type")
  summary       String              @db.Text
  conclusion    String?             @db.Text
  attachmentUrl String?             @map("attachment_url")
  isPublished   Boolean             @default(false) @map("is_published")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  project       ResearchProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trial         ResearchTrial?      @relation(fields: [trialId], references: [id], onDelete: SetNull)
  recordedBy    User                @relation("UserResearchFindings", fields: [recordedById], references: [id])

  @@map("research_findings")
}

// ==========================================
// 16. AUDITORÍA DE RECUENTO FÍSICO DE NEVERAS (FASE 4)
// ==========================================

model FridgePhysicalAudit {
  id            Int                       @id @default(autoincrement())
  code          String                    @unique
  performedById Int                       @map("performed_by_id")
  auditDate     DateTime                  @default(now()) @map("audit_date")
  notes         String?                   @db.Text
  createdAt     DateTime                  @default(now()) @map("created_at")

  performedBy   User                      @relation(fields: [performedById], references: [id])
  items         FridgePhysicalAuditItem[]

  @@map("fridge_physical_audits")
}

model FridgePhysicalAuditItem {
  id                    Int                         @id @default(autoincrement())
  auditId               Int                         @map("audit_id")
  labReagentUnitId      BigInt                      @map("lab_reagent_unit_id")
  systemRemainingUses   Int                         @map("system_remaining_uses")
  physicalRemainingUses Int                         @map("physical_remaining_uses")
  variance              Int
  adjustmentStatus      FridgeAuditAdjustmentStatus @default(ADJUSTED_AND_RECONCILED) @map("adjustment_status")
  notes                 String?                     @db.Text

  audit                 FridgePhysicalAudit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  labReagentUnit        LabReagentUnit              @relation(fields: [labReagentUnitId], references: [id])

  @@map("fridge_physical_audit_items")
}

