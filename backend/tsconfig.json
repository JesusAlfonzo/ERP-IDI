{
  "compilerOptions": {
    // Rutas de entrada y salida
    "rootDir": "./src",
    "outDir": "./dist",

    // Entorno Node.js moderno
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],

    // Generación de artefactos limpios
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,

    // Verificación estricta
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
